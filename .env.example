# Supabase: usar la cadena "Transaction pooler" del dashboard
# Project Settings > Database > Connection string > URI (Transaction pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
CLAVE_SUPERADMIN=clave-segura-aqui
ANTHROPIC_MODEL_PENSAR=claude-sonnet-5
ANTHROPIC_MODEL_REDACTAR=claude-haiku-4-5
PORT=3000
