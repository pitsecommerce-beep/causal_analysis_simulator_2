{
  "name": "simulador-analisis-causal",
  "version": "1.0.0",
  "description": "Simulador de Análisis Causal ETF Bank - IPADE Business School",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "datos:verificar": "npx tsx src/servidor/consola/verificar-datos.ts",
    "test": "npx vitest run",
    "motor:consola": "npx tsx src/servidor/consola/arnes.ts",
    "dev:server": "npx tsx --watch src/servidor/index.ts",
    "dev:client": "npx vite",
    "build": "npx tsc && npx vite build && mkdir -p dist/src/servidor/db/migraciones && cp src/servidor/db/migraciones/*.sql dist/src/servidor/db/migraciones/ && mkdir -p dist/src/servidor/voz/guiones && cp src/servidor/voz/guiones/*.txt dist/src/servidor/voz/guiones/",
    "start": "node dist/src/servidor/index.js",
    "salud": "npx tsx src/servidor/consola/salud.ts",
    "voz:respaldo": "npx tsx src/servidor/consola/generar-respaldo.ts",
    "voz:probar": "npx tsx src/servidor/consola/probar-voz.ts",
    "tablero:demo": "npx tsx src/servidor/consola/tablero-demo.ts",
    "sprites:generar": "npx tsx herramientas/sprites/generar.ts",
    "estilos:demo": "npx vite --open /estilos-demo.html",
    "escena:demo": "npx vite --open /demo.html",
    "resiliencia:probar": "npx tsx src/servidor/consola/resiliencia.ts",
    "acentos:revisar": "bash herramientas/acentos-revisar.sh",
    "contraste:revisar": "npx tsx herramientas/contraste-revisar.ts",
    "proyeccion:demo": "npx tsx src/servidor/consola/proyeccion-demo.ts",
    "journey:probar": "npx tsx src/servidor/consola/journey-probar.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
